#!/usr/bin/env bash

selection=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}
OPENER="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/plugins/nuke"

text_files=()
other_files=()

categorize_file() {
    local f="$1"
    case $(file --mime-type -Lb -- "$f") in
        text/*) text_files+=("$f") ;;
        *)      other_files+=("$f") ;;
    esac
}

if [ -s "$selection" ]; then
    while IFS= read -r -d '' entry || [ -n "$entry" ]; do
        [ -n "$entry" ] && categorize_file "$entry"
    done < "$selection"
    if [ -p "$NNN_PIPE" ]; then
        printf "-" > "$NNN_PIPE"
    fi
else
    exit 0
fi

for f in "${other_files[@]}"; do
    ${OPENER:-xdg-open} "$f" > /dev/null 2>&1 &
done

if [ ${#text_files[@]} -gt 0 ]; then
    ${EDITOR:-vi} "${text_files[@]}"
fi
